lib_monthNumToName(){
    case $1 in
        1 ) month="Jan";;
        2 ) month="Feb";;
        3 ) month="Mar";;
        4 ) month="Apr";;
        5 ) month="May";;
        6 ) month="Jun";;
        7 ) month="Jul";;
        8 ) month="Aug";;
        9 ) month="Sep";;
        10 ) month="Oct";;
        11 ) month="Nov";;
        12 ) month="Dec";;
        * ) echo "$0: Unknow month value $1" >&2
            exit 1
    esac
    return 0
}
